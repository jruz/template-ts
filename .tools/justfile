mod just 'just.just'
mod nix 'nix.just'
mod nushell 'nushell.just'
mod woodpecker 'woodpecker.just'
mod renovate 'renovate.just'

check:
    just --justfile {{ justfile() }} just::check
    just --justfile {{ justfile() }} nix::check
    just --justfile {{ justfile() }} nushell::check
    just --justfile {{ justfile() }} woodpecker::check
    just --justfile {{ justfile() }} renovate::check

fix:
    just --justfile {{ justfile() }} just::fix
    just --justfile {{ justfile() }} nix::fix
    just --justfile {{ justfile() }} nushell::fix
